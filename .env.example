# WebSocket Server
WS_SERVER_HOST=0.0.0.0
WS_SERVER_PORT=8000

# Performance
UPDATE_INTERVAL_MS=100

# Logging
LOG_LEVEL=INFO

# Frontend (optional)
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000/api
